{
  "name": "@lobechat/database",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/database/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --project packages/database/tsconfig.json"
      },
      "outputs": [
        "{workspaceRoot}/packages/database/dist"
      ],
      "cache": true,
      "dependsOn": [
        "@lobechat/agent-templates:build",
        "@lobechat/business-const:build",
        "@lobechat/const:build",
        "@lobechat/conversation-flow:build",
        "@lobechat/types:build",
        "@lobechat/utils:build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run packages/database"
      },
      "cache": true,
      "dependsOn": [
        "build"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf packages/database/dist"
      }
    }
  },
  "tags": [
    "scope:@lobechat/database"
  ]
}

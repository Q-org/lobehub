{
  "name": "@lobechat/utils",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/utils/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --project packages/utils/tsconfig.json"
      },
      "outputs": [
        "{workspaceRoot}/packages/utils/dist"
      ],
      "cache": true,
      "dependsOn": [
        "@lobechat/const:build",
        "@lobechat/types:build",
        "model-bank:build",
        "@lobechat/ssrf-safe-fetch:build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run packages/utils"
      },
      "cache": true,
      "dependsOn": [
        "build"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf packages/utils/dist"
      }
    }
  },
  "tags": [
    "scope:@lobechat/utils"
  ]
}

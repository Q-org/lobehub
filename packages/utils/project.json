{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@lobechat/utils",
  "projectType": "library",
  "sourceRoot": "packages/utils/src",
  "tags": ["scope:utils", "type:library"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --project packages/utils/tsconfig.json --noEmit false",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/packages/utils/dist"],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --silent='passed-only' 'packages/utils'",
        "cwd": "{workspaceRoot}"
      },
      "cache": true
    }
  }
}

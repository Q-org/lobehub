{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@lobechat/types",
  "projectType": "library",
  "sourceRoot": "packages/types/src",
  "tags": ["scope:types", "type:library"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --project packages/types/tsconfig.json --noEmit false",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/packages/types/dist"],
      "cache": true
    }
  }
}

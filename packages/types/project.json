{
  "name": "@lobechat/types",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/types/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --project packages/types/tsconfig.json"
      },
      "outputs": [
        "{workspaceRoot}/packages/types/dist"
      ],
      "cache": true,
      "dependsOn": [
        "@lobechat/python-interpreter:build",
        "@lobechat/web-crawler:build",
        "model-bank:build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run packages/types"
      },
      "cache": true,
      "dependsOn": [
        "build"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf packages/types/dist"
      }
    }
  },
  "tags": [
    "scope:@lobechat/types"
  ]
}

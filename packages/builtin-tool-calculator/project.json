{
  "name": "@lobechat/builtin-tool-calculator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/builtin-tool-calculator/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --project packages/builtin-tool-calculator/tsconfig.json"
      },
      "outputs": [
        "{workspaceRoot}/packages/builtin-tool-calculator/dist"
      ],
      "cache": true,
      "dependsOn": [
        "@lobechat/prompts:build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run packages/builtin-tool-calculator"
      },
      "cache": true,
      "dependsOn": [
        "build"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf packages/builtin-tool-calculator/dist"
      }
    }
  },
  "tags": [
    "scope:@lobechat/builtin-tool-calculator"
  ]
}

{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@lobechat/const",
  "projectType": "library",
  "sourceRoot": "packages/const/src",
  "tags": ["scope:const", "type:library"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --project packages/const/tsconfig.json --noEmit false",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/packages/const/dist"],
      "cache": true
    }
  }
}

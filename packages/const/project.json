{
  "name": "@lobechat/const",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/const/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --project packages/const/tsconfig.json"
      },
      "outputs": [
        "{workspaceRoot}/packages/const/dist"
      ],
      "cache": true,
      "dependsOn": [
        "@lobechat/business-const:build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run packages/const"
      },
      "cache": true,
      "dependsOn": [
        "build"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf packages/const/dist"
      }
    }
  },
  "tags": [
    "scope:@lobechat/const"
  ]
}

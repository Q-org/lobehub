{
  "name": "@lobechat/agent-runtime",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/agent-runtime/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --project packages/agent-runtime/tsconfig.json"
      },
      "outputs": [
        "{workspaceRoot}/packages/agent-runtime/dist"
      ],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run packages/agent-runtime"
      },
      "cache": true,
      "dependsOn": [
        "build"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf packages/agent-runtime/dist"
      }
    }
  },
  "tags": [
    "scope:@lobechat/agent-runtime"
  ]
}

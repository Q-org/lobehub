{
  "name": "@lobechat/openapi",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/openapi/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --project packages/openapi/tsconfig.json"
      },
      "outputs": [
        "{workspaceRoot}/packages/openapi/dist"
      ],
      "cache": true,
      "dependsOn": [
        "@lobechat/model-runtime:build",
        "@lobechat/types:build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run packages/openapi"
      },
      "cache": true,
      "dependsOn": [
        "build"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf packages/openapi/dist"
      }
    }
  },
  "tags": [
    "scope:@lobechat/openapi"
  ]
}

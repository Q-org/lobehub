{
  "name": "@lobechat/builtin-tools",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/builtin-tools/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --project packages/builtin-tools/tsconfig.json"
      },
      "outputs": [
        "{workspaceRoot}/packages/builtin-tools/dist"
      ],
      "cache": true,
      "dependsOn": [
        "@lobechat/builtin-tool-activator:build",
        "@lobechat/builtin-tool-agent-builder:build",
        "@lobechat/builtin-tool-agent-documents:build",
        "@lobechat/builtin-tool-brief:build",
        "@lobechat/builtin-tool-cloud-sandbox:build",
        "@lobechat/builtin-tool-creds:build",
        "@lobechat/builtin-tool-group-agent-builder:build",
        "@lobechat/builtin-tool-group-management:build",
        "@lobechat/builtin-tool-gtd:build",
        "@lobechat/builtin-tool-knowledge-base:build",
        "@lobechat/builtin-tool-local-system:build",
        "@lobechat/builtin-tool-memory:build",
        "@lobechat/builtin-tool-message:build",
        "@lobechat/builtin-tool-notebook:build",
        "@lobechat/builtin-tool-page-agent:build",
        "@lobechat/builtin-tool-remote-device:build",
        "@lobechat/builtin-tool-skill-store:build",
        "@lobechat/builtin-tool-skills:build",
        "@lobechat/builtin-tool-task:build",
        "@lobechat/builtin-tool-topic-reference:build",
        "@lobechat/builtin-tool-user-interaction:build",
        "@lobechat/builtin-tool-web-browsing:build",
        "@lobechat/builtin-tool-web-onboarding:build",
        "@lobechat/const:build",
        "@lobechat/types:build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run packages/builtin-tools"
      },
      "cache": true,
      "dependsOn": [
        "build"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf packages/builtin-tools/dist"
      }
    }
  },
  "tags": [
    "scope:@lobechat/builtin-tools"
  ]
}

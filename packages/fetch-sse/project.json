{
  "name": "@lobechat/fetch-sse",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/fetch-sse/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --project packages/fetch-sse/tsconfig.json"
      },
      "outputs": [
        "{workspaceRoot}/packages/fetch-sse/dist"
      ],
      "cache": true,
      "dependsOn": [
        "@lobechat/const:build",
        "@lobechat/model-runtime:build",
        "@lobechat/utils:build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run packages/fetch-sse"
      },
      "cache": true,
      "dependsOn": [
        "build"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf packages/fetch-sse/dist"
      }
    }
  },
  "tags": [
    "scope:@lobechat/fetch-sse"
  ]
}

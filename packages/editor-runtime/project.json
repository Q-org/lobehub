{
  "name": "@lobechat/editor-runtime",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/editor-runtime/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --project packages/editor-runtime/tsconfig.json"
      },
      "outputs": [
        "{workspaceRoot}/packages/editor-runtime/dist"
      ],
      "cache": true,
      "dependsOn": [
        "@lobechat/prompts:build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run packages/editor-runtime"
      },
      "cache": true,
      "dependsOn": [
        "build"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf packages/editor-runtime/dist"
      }
    }
  },
  "tags": [
    "scope:@lobechat/editor-runtime"
  ]
}

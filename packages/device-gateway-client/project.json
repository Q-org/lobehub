{
  "name": "@lobechat/device-gateway-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/device-gateway-client/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --project packages/device-gateway-client/tsconfig.json"
      },
      "outputs": [
        "{workspaceRoot}/packages/device-gateway-client/dist"
      ],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run packages/device-gateway-client"
      },
      "cache": true,
      "dependsOn": [
        "build"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf packages/device-gateway-client/dist"
      }
    }
  },
  "tags": [
    "scope:@lobechat/device-gateway-client"
  ]
}
